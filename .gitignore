# 비밀 (커밋 금지)
.env
.env.*
!.env.example
.envrc
*-key.json
secrets/

# Claude Code 개인 설정 (팀 설정 .claude/settings.json 은 커밋. 파일명은 2.1.311 문서로 확인)
.claude/settings.local.json
# 키트 개인 설정 (scripts/setup/kit_setup.py가 씀: 프로젝트 ID·gcloud 설정 폴더·GitHub 아이디)
.kit_local.json

# Hook 실행 상태 (고친 경로, 재시도 수)
.claude/state/

# 생성물
out/

# 로그 기록 도구의 잠금 파일 (.dev의 로그 자체는 커밋한다)
.dev/*.lock

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# IDE·OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# 주의
